# PlanItPoker — Container / production env template.
# Copy to .env and adjust: cp .env.example .env

# Backend (server container). Comma-separated origins for Express CORS and the
# WebSocket handshake. Browsers must match one of these; non-browser clients
# (no Origin header) must instead present a valid session token on JOIN_ROOM.
# Same-origin compose deploys work with the defaults below.
# Production examples:
#   ALLOWED_ORIGINS=https://planitpoker.vercel.app
#   ALLOWED_ORIGINS=https://app.your-domain.com
PORT=5000
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Frontend (client container build-arg). Empty = same-origin via Nginx /ws proxy (recommended).
# Set to dial an external backend directly, e.g. wss://api.exemplo.com
VITE_WS_URL=

# Host port mappings for `docker compose up`.
SERVER_PORT=5000
CLIENT_PORT=80
