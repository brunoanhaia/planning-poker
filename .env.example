# PlanItPoker — Container / production env template.
# Copy to .env and adjust: cp .env.example .env

# Backend (server container). Comma-separated origins for Express CORS and the
# WebSocket handshake. Browsers must match one of these; non-browser clients
# (no Origin header) must instead present a valid session token on JOIN_ROOM.
# Same-origin compose deploys work with the defaults below.
# Production examples:
#   ALLOWED_ORIGINS=https://planitpoker.vercel.app
#   ALLOWED_ORIGINS=https://app.your-domain.com
PORT=5000
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Backend (server container). Number of reverse-proxy hops in front of the server.
# 0 = do not trust X-Forwarded-For at all (safe default for a direct listener);
# 1 = the bundled Nginx stack. The browser-identity cookie and every per-address
# abuse control read the client address through this setting.
TRUST_PROXY_HOPS=0

# Backend (server container). Set to true when the deployment is served over TLS,
# so the browser-identity cookie is only ever sent over HTTPS. Leave it empty on
# plain HTTP, where a browser would drop a Secure cookie.
CLIENT_ID_COOKIE_SECURE=

# Backend (server container). Set to true when the deployment sits behind Cloudflare,
# so the server takes the real client from CF-Connecting-IP — and only for requests
# that genuinely arrive from a published Cloudflare address, a forged header from
# anyone else being ignored. Leave it empty on a direct listener, including the
# bundled Nginx stack, which uses TRUST_PROXY_HOPS instead.
CLOUDFLARE_ENABLED=

# Frontend (client container build-arg). Empty = same-origin via Nginx /ws proxy (recommended).
# Set to dial an external backend directly, e.g. wss://api.exemplo.com
VITE_WS_URL=

# Host port mappings for `docker compose up`.
SERVER_PORT=5000
CLIENT_PORT=80
