{
    "name": "planitpoker-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:server": "npm --workspace=@planitpoker/server run dev",
        "dev:client": "npm --workspace=@planitpoker/client run dev",
        "build:shared": "npm --workspace=@planitpoker/shared run build",
        "build": "npm run build:shared && npm run build --workspaces --if-present",
        "test:server": "npm --workspace=@planitpoker/server run test",
        "test:client": "npm --workspace=@planitpoker/client run test",
        "test": "npm run test --workspaces --if-present",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:commits": "commitlint --from origin/main",
        "changelog": "conventional-changelog -p conventionalcommits -r 0 -o CHANGELOG.md",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "conventional-changelog": "^8.1.3",
        "conventional-changelog-conventionalcommits": "^10.4.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "husky": "^9.1.7",
        "prettier": "^3.9.10"
    }
}
